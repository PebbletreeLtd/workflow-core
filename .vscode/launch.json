{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "runtimeVersion": "18",
            "name": "Debug Vitest",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": [
                "run",
                "--no-file-parallelism"
            ],
            "console": "integratedTerminal",
            "smartStep": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debug Current Test File",
            "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
            "args": [
                "run",
                "--no-file-parallelism",
                "${relativeFile}"
            ],
            "console": "integratedTerminal",
            "smartStep": true
        }
    ]
}