{
  "name": "@pebbletree/workflow-core",
  "version": "4.0.0",
  "description": "Database-agnostic workflow engine for TypeScript — job picking, execution, retry, scheduling, and capability-based routing with pluggable storage adapters",
  "keywords": [
    "workflow",
    "job-queue",
    "background-jobs",
    "task-scheduler",
    "retry",
    "job-manager",
    "capability-routing",
    "typescript"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --import ./dist/tests/setup.js --test dist/tests/*.test.js",
    "test:verbose": "npm run build && VERBOSE=1 node --import ./dist/tests/setup.js --test dist/tests/*.test.js",
    "test:watch": "npm run build && node --import ./dist/tests/setup.js --test --watch dist/tests/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PebbletreeLtd/workflow-core.git"
  },
  "author": "Pebbletree Ltd",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/PebbletreeLtd/workflow-core/issues"
  },
  "homepage": "https://github.com/PebbletreeLtd/workflow-core#readme",
  "devDependencies": {
    "@types/node": "~18.19.130",
    "typescript": "~5.9.3",
    "uuid": "~8.3.2"
  },
  "dependencies": {
    "@pebbletree/mvcc-testing": "~2.1.5",
    "@pebbletree/tokenring": "~2.1.7",
    "@types/uuid": "~8.3.0"
  }
}